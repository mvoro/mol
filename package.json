{
  "name": "composer-chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:pages": "vite build --base=/mol/ && node scripts/prepare-pages-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:artifacts": "node qa/artifact-panel.mjs && node qa/artifact-documents.mjs && node qa/artifact-upload.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "border-beam": "^1.3.0",
    "dompurify": "^3.4.15",
    "img-fx": "^0.5.1",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
